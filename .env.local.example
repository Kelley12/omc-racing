# Copy this file to .env.local and fill in your values
# .env.local is git-ignored — never commit real keys

# Google Calendar API
# 1. Go to console.cloud.google.com → APIs & Services → Credentials
# 2. Create an API key restricted to the Google Calendar API
# 3. Paste it here
NEXT_PUBLIC_GOOGLE_CALENDAR_API_KEY=your_api_key_here

# Your club's Google Calendar ID
# Found in Google Calendar settings → Integrate calendar → Calendar ID
# Looks like: abc123@group.calendar.google.com
NEXT_PUBLIC_GOOGLE_CALENDAR_ID=your_calendar_id_here
